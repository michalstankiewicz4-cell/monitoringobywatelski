{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Odkryj incydenty",
			"type": "shell",
			"command": "node scripts/discover_incidents.mjs",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Commit automation cleanup",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"-A",
				";",
				"git",
				"commit",
				"-m",
				"cleanup: remove admin review flow and expand police phrases",
				";",
				"git",
				"push",
				"origin",
				"main"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Commit and push current changes",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-Command",
				"git add -A; git commit -m 'cleanup: remove admin review flow and expand police phrases'; git push origin main"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}